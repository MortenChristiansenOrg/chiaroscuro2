{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": ["src/renderer/src/DesignMockups.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ],
  "files": {
    "ignore": [
      "dist/",
      "out/",
      "node_modules/",
      "src/renderer/src/components/ui/",
      "design-system/dist/",
      "**/*.generated.ts",
      ".agent-project/",
      ".claude/worktrees/",
      "test-results/"
    ]
  }
}
