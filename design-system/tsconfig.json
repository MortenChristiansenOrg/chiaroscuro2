{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "../out/tsconfig.docs",
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@docs/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
