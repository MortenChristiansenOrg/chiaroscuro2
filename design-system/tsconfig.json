{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "..",
    "outDir": "../out/tsconfig.docs",
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@features/*": ["../src/features/*"],
      "@docs/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../src/shared/**/*",
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/Shell.tsx",
    "../src/renderer/src/components/TooltipLayer.tsx",
    "../src/renderer/src/components/Icon.tsx",
    "../src/renderer/src/components/ContentArea.tsx",
    "../src/renderer/src/components/ContextMenu.tsx",
    "../src/renderer/src/components/BuiltInPage.tsx",
    "../src/renderer/src/components/SettingsLayout.tsx",
    "../src/features/**/*.renderer.tsx",
    "../src/features/sidebar/Favicon.tsx",
    "../src/features/sidebar/TabItem.tsx",
    "../src/features/sidebar/FolderHeader.tsx",
    "../src/features/sidebar/FolderGroup.tsx",
    "../src/features/sidebar/BookmarkedTree.tsx",
    "../src/features/sidebar/PinnedTabsStrip.tsx",
    "../src/features/sidebar/SectionDropZone.tsx",
    "../src/features/sidebar/TabSection.tsx",
    "../src/features/sidebar/SidebarContext.tsx",
    "../src/features/**/*.store.ts",
    "../src/features/**/*.shared.ts",
    "../src/features/sub-tabs/SubTabFrame.tsx",
    "../src/features/command-palette/resolve-input.ts",
    "../src/bus/types.ts"
  ]
}
