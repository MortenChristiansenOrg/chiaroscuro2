{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": "..",
    "outDir": "../out/tsconfig.docs",
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@features/*": ["../src/features/*"],
      "@docs/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../src/shared/**/*",
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/Shell.tsx",
    "../src/renderer/src/components/TooltipLayer.tsx",
    "../src/renderer/src/components/Icon.tsx",
    "../src/renderer/src/components/ContentArea.tsx",
    "../src/renderer/src/components/ContextMenu.tsx",
    "../src/features/**/*.renderer.tsx",
    "../src/features/**/*.store.ts",
    "../src/features/**/*.shared.ts",
    "../src/features/command-palette/resolve-input.ts"
  ]
}
