{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./out/tsconfig.web",
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/bus/**/*",
    "src/shared/**/*",
    "src/features/**/*.feature.ts",
    "src/features/**/*.renderer.tsx",
    "src/features/sidebar/Favicon.tsx",
    "src/features/sidebar/TabItem.tsx",
    "src/features/sidebar/FolderHeader.tsx",
    "src/features/sidebar/FolderGroup.tsx",
    "src/features/sidebar/BookmarkedTree.tsx",
    "src/features/sidebar/PinnedTabsStrip.tsx",
    "src/features/sidebar/SectionDropZone.tsx",
    "src/features/sidebar/TabSection.tsx",
    "src/features/sidebar/SidebarContext.tsx",
    "src/features/**/*.store.ts",
    "src/features/**/*.shared.ts",
    "src/features/command-palette/resolve-input.ts",
    "src/features/sub-tabs/SubTabFrame.tsx",
    "src/features/domain-css/domain-settings-page.tsx"
  ],
  "exclude": ["src/bus/ipc-main-bridge.ts"]
}
