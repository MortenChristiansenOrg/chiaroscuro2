{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./out/tsconfig.web",
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/bus/**/*",
    "src/shared/**/*",
    "src/features/**/*.feature.ts",
    "src/features/**/*.renderer.tsx",
    "src/features/**/*.store.ts",
    "src/features/**/*.shared.ts"
  ],
  "exclude": ["src/bus/ipc-main-bridge.ts"]
}
