{
  "name": "chiaroscuro",
  "version": "0.1.0",
  "private": true,
  "description": "Personal TypeScript browser built on Electron",
  "main": "./out/main/index.js",
  "scripts": {
    "generate:icons": "bun scripts/generate-fa-icons.ts",
    "dev": "bun run generate:icons && electron-vite dev",
    "build": "bun run generate:icons && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bunx playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --build",
    "dev:win": "./scripts/dev-win.sh",
    "verify": "./scripts/verify-all.sh",
    "docs:dev": "bun run generate:icons && vite --config design-system/vite.config.ts",
    "docs:build": "bun run generate:icons && vite build --config design-system/vite.config.ts",
    "docs:preview": "vite preview --config design-system/vite.config.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "electron-updater": "^6.6.2",
    "mupdf": "^1.27.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "rxdb": "^16.12.0",
    "zod": "^3.25.67",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wouter": "^3.9.0"
  }
}
